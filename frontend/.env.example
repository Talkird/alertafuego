# Copiar a .env y completar. Los valores de este archivo son de ejemplo.

# Proyecto de Supabase (URL y clave pública "anon").
NUXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=tu-clave-publica-anon

# URL de la API del backend. Para desarrollo local:
NUXT_PUBLIC_API_BASE=http://localhost:8000

# Opcional: habilita las capas de clima del mapa (clave gratuita de openweathermap.org).
NUXT_PUBLIC_OWM_API_KEY=
