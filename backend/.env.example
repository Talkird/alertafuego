# Copiar a .env y completar. Los valores de este archivo son de ejemplo.

# Base de datos PostgreSQL con PostGIS (por ejemplo, Supabase).
DATABASE_URL=postgresql+psycopg://usuario:contraseña@localhost:5432/alertafuego

# URL del proyecto de Supabase; se usa para validar los tokens de sesión.
SUPABASE_URL=https://tu-proyecto.supabase.co

# Proyecto de Google Cloud habilitado para Google Earth Engine.
EARTH_ENGINE_PROJECT_ID=tu-proyecto-earth-engine

# Clave que exige el endpoint de detección programada (cualquier cadena larga).
DETECT_API_KEY=cambiar-por-una-clave-larga

# Opcional: carpeta donde se guardan imágenes de depuración de cada escaneo.
DEBUG_IMAGE_DIR=

# Orígenes permitidos por CORS, separados por coma, y URL pública del frontend.
FRONTEND_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Opcional: alertas por correo (remitente verificado en Amazon SES).
ALERT_EMAIL_FROM=

# Opcional: alertas por Telegram (bot creado con BotFather).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Opcionales, desactivadas por defecto ("1" las activa):
# CONFIRM_ALERTS: alertar solo si el foco se repite en una de las dos imágenes anteriores.
# GROUP_FIRES: informar un foco por grupo de píxeles contiguos en lugar de uno por píxel.
# DETECTION_WORKER: montar la ruta de detección programada (la usa la Lambda del detector).
CONFIRM_ALERTS=
GROUP_FIRES=
DETECTION_WORKER=

# Solo en AWS: ARN del secreto con la cuenta de servicio de Earth Engine.
EE_SERVICE_ACCOUNT_SECRET_ARN=
